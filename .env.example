# ==============================================================================
# HỆ THỐNG FASTSHIP LOGISTICS - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env)
# ==============================================================================

# 1. Cấu hình Cổng chạy Web
PORT=3000
VITE_PORT=3000
VITE_API_BASE_URL="http://localhost:3000/api"

# 2. Cấu hình Kết nối CSDL MySQL (XAMPP mặc định)
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="fastship_db"
DB_USER="root"
DB_PASSWORD=""

# 3. Bảo mật Xác thực Đăng nhập & Session
JWT_SECRET="fastship_logistics_jwt_secret_key_2026"
SESSION_SECRET="fastship_session_secret_local"

# 4. Môi trường chạy
NODE_ENV="development"
APP_URL="http://localhost:3000"
